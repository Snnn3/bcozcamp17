// Camp Platform single-camp database schema for Sprint 0–2.
// Import this file into dbdiagram.io using the DBML format.
// Source of truth: CAMP_DATABASE_SCHEMA.md

Project camp_platform_sprint_0_2 {
  database_type: "PostgreSQL"
}

Enum camp_status {
  draft
  registration_open
  registration_closed
  archived
}

Enum user_status {
  active
  disabled
}

Enum application_status {
  draft
  submitted
  reviewing
  action_required
  resubmitted
  accepted
  rejected
  waitlisted
  withdrawn
}

Enum document_status {
  not_uploaded
  pending
  approved
  correction_required
  rejected
}

Enum application_field_data_type {
  text
  number
  date
  boolean
  single_choice
  multi_choice
}

Enum permission_effect {
  allow
  deny
}

Enum document_review_status {
  approved
  correction_required
  rejected
}

Enum notification_type {
  application_submitted
  document_action_required
  document_reviewed
  replacement_received
  application_status_changed
}

Table camp_settings {
  id uuid [pk, note: 'Exactly one row for this one-time camp']
  singleton_key smallint [not null, unique, default: 1, note: 'SQL CHECK = 1; runtime role cannot delete singleton']
  version int [not null, default: 1]
  privacy_notice_version varchar(50)
  privacy_notice_url text
  name varchar(255) [not null]
  status camp_status [not null]
  timezone varchar(64) [not null]
  capacity int [not null, note: 'Must be positive']
  registration_opens_at timestamptz [not null]
  registration_closes_at timestamptz [not null]
  correction_closes_at timestamptz
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table users {
  id uuid [pk]
  google_subject varchar(255) [not null, unique, note: 'Immutable verified Google sub; authoritative identity key']
  email varchar(320) [not null, unique, note: 'Verified Google email metadata; collision denies sign-in, never auto-links']
  status user_status [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table roles {
  id uuid [pk]
  code varchar(30) [not null, unique, note: 'Seed participant, staff, and admin']
  name varchar(100) [not null]
}

Table user_roles {
  user_id uuid [not null]
  role_id uuid [not null]
  created_at timestamptz [not null]

  indexes {
    (user_id, role_id) [pk]
  }
}

Table permissions {
  id uuid [pk]
  code varchar(100) [not null, unique]
  name varchar(150) [not null]
}

Table role_permissions {
  role_id uuid [not null]
  permission_id uuid [not null]

  indexes {
    (role_id, permission_id) [pk]
  }
}

Table user_permissions {
  user_id uuid [not null]
  permission_id uuid [not null]
  effect permission_effect [not null]
  granted_by uuid [not null]
  created_at timestamptz [not null]

  indexes {
    (user_id, permission_id) [pk]
  }
}

Table participant_profiles {
  id uuid [pk]
  user_id uuid [not null, unique]
  full_name varchar(255) [note: 'Required at submission; nullable in draft']
  contact_email varchar(320) [note: 'Required at submission; nullable in draft']
  phone varchar(50) [note: 'Required at submission; nullable in draft']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table application_fields {
  id uuid [pk]
  field_code varchar(100) [not null, unique]
  label varchar(255) [not null]
  data_type application_field_data_type [not null]
  is_required boolean [not null]
  is_active boolean [not null]
  display_order int [not null]

  indexes {
    (display_order)
  }
}

Table application_field_options {
  id uuid [pk]
  field_id uuid [not null]
  option_code varchar(100) [not null]
  label varchar(255) [not null]
  display_order int [not null]

  indexes {
    (field_id, option_code) [unique]
  }
}

Table applications {
  id uuid [pk]
  participant_id uuid [not null]
  application_code varchar(100) [unique, note: 'Required after final submission']
  status application_status [not null]
  version int [not null, note: 'Starts at 1']
  submitted_at timestamptz
  correction_deadline timestamptz
  privacy_notice_version varchar(50)
  privacy_acknowledged_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (participant_id) [unique]
    (status)
  }
}

Table application_answers {
  id uuid [pk]
  application_id uuid [not null]
  field_id uuid [not null]
  answer_text text [note: 'Null when using application_answer_options']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (application_id, field_id) [unique]
  }
}

Table application_answer_options {
  answer_id uuid [not null]
  option_id uuid [not null]

  indexes {
    (answer_id, option_id) [pk]
  }
}

Table application_status_history {
  id uuid [pk]
  application_id uuid [not null]
  from_status application_status
  to_status application_status [not null]
  reason text
  changed_by uuid [not null]
  created_at timestamptz [not null]

  indexes {
    (application_id, created_at)
  }
}

Table document_types {
  id uuid [pk]
  code varchar(100) [not null, unique]
  name varchar(255) [not null]
  is_required boolean [not null]
  max_size_bytes bigint [not null]
  max_count int [not null, default: 1, note: 'SQL CHECK = 1 for Sprint 0-2']
  max_replacements int [not null, note: 'Nonnegative; initial upload does not count']
  replacement_allowed boolean [not null]
  is_active boolean [not null]
  display_order int [not null]

  indexes {
    (display_order)
  }
}

Table mime_types {
  id uuid [pk]
  code varchar(100) [not null, unique]
  description varchar(255) [not null]
}

Table document_type_mime_types {
  document_type_id uuid [not null]
  mime_type_id uuid [not null]

  indexes {
    (document_type_id, mime_type_id) [pk]
  }
}

Table application_documents {
  id uuid [pk]
  version int [not null, default: 1, note: 'Increments on review and completion, including same-file review']
  replacement_count int [not null, default: 0]
  application_id uuid [not null]
  document_type_id uuid [not null]
  status document_status [not null]
  applicant_message text
  replacement_allowed boolean [not null]
  current_submission_id uuid [note: 'Current-state pointer; history remains in document_submissions']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (application_id, document_type_id) [unique]
    (application_id, status)
  }
}

Table document_submissions {
  id uuid [pk]
  application_document_id uuid [not null]
  version_number int [not null]
  storage_key varchar(500) [not null, unique, note: 'Private object-storage key']
  original_filename varchar(255) [not null]
  mime_type varchar(100) [not null, note: 'Detected server-side']
  size_bytes bigint [not null]
  checksum varchar(128) [not null, note: 'Server-computed SHA-256']
  uploaded_by uuid [not null]
  uploaded_at timestamptz [not null]

  indexes {
    (application_document_id, version_number) [unique]
  }
}

Table document_review_history {
  id uuid [pk]
  document_version int [not null]
  replacement_allowed boolean [not null]
  application_document_id uuid [not null]
  submission_id uuid [not null]
  reviewer_id uuid [not null]
  status document_review_status [not null]
  applicant_message text [note: 'Required for correction_required and rejected']
  internal_note text [note: 'Never exposed to applicants']
  created_at timestamptz [not null]

  indexes {
    (application_document_id, created_at)
    (application_document_id, document_version) [unique]
    (submission_id)
  }
}

Table in_app_notifications {
  id uuid [pk]
  user_id uuid [not null]
  type notification_type [not null]
  title varchar(255) [not null]
  message text [not null]
  is_read boolean [not null]
  created_at timestamptz [not null]
  read_at timestamptz

  indexes {
    (user_id, is_read, created_at)
  }
}

Table notification_applications {
  notification_id uuid [not null]
  application_id uuid [not null]

  indexes {
    (notification_id, application_id) [pk]
    (application_id, notification_id)
  }
}

Table notification_documents {
  notification_id uuid [not null]
  application_document_id uuid [not null]

  indexes {
    (notification_id, application_document_id) [pk]
    (application_document_id, notification_id)
  }
}

Table audit_logs {
  id uuid [pk]
  actor_id uuid [note: 'Null for system actions']
  action varchar(100) [not null]
  entity_type varchar(100) [not null]
  entity_id uuid [not null]
  created_at timestamptz [not null]

  indexes {
    (entity_type, entity_id, created_at)
  }
}

Table audit_log_values {
  audit_log_id uuid [not null]
  attribute_name varchar(100) [not null]
  old_value_text text
  new_value_text text

  indexes {
    (audit_log_id, attribute_name) [pk]
  }
}

Ref: user_roles.user_id > users.id
Ref: user_roles.role_id > roles.id
Ref: role_permissions.role_id > roles.id
Ref: role_permissions.permission_id > permissions.id
Ref: user_permissions.user_id > users.id
Ref: user_permissions.permission_id > permissions.id
Ref: user_permissions.granted_by > users.id
Ref: participant_profiles.user_id - users.id

Ref: application_field_options.field_id > application_fields.id
Ref: applications.participant_id > participant_profiles.id
Ref: application_answers.application_id > applications.id
Ref: application_answers.field_id > application_fields.id
Ref: application_answer_options.answer_id > application_answers.id
Ref: application_answer_options.option_id > application_field_options.id
Ref: application_status_history.application_id > applications.id
Ref: application_status_history.changed_by > users.id

Ref: document_type_mime_types.document_type_id > document_types.id
Ref: document_type_mime_types.mime_type_id > mime_types.id
Ref: application_documents.application_id > applications.id
Ref: application_documents.document_type_id > document_types.id
Ref: application_documents.current_submission_id - document_submissions.id
Ref: document_submissions.application_document_id > application_documents.id
Ref: document_submissions.uploaded_by > users.id
Ref: document_review_history.application_document_id > application_documents.id
Ref: document_review_history.submission_id > document_submissions.id
Ref: document_review_history.reviewer_id > users.id

Ref: in_app_notifications.user_id > users.id
Ref: notification_applications.notification_id > in_app_notifications.id
Ref: notification_applications.application_id > applications.id
Ref: notification_documents.notification_id > in_app_notifications.id
Ref: notification_documents.application_document_id > application_documents.id

Ref: audit_logs.actor_id > users.id
Ref: audit_log_values.audit_log_id > audit_logs.id

Enum upload_status {
  issued
  validating
  completed
  failed
  expired
}

Table upload_intents {
  id uuid [pk]
  application_document_id uuid [not null]
  uploaded_by uuid [not null]
  base_document_version int [not null]
  configuration_version int [not null]
  staging_key varchar(500) [not null, unique]
  immutable_key varchar(500) [unique]
  original_filename varchar(255) [not null]
  declared_mime_type varchar(100) [not null]
  declared_size_bytes bigint [not null]
  status upload_status [not null]
  failure_code varchar(100)
  result_submission_id uuid [unique]
  created_at timestamptz [not null]
  expires_at timestamptz [not null]
  lease_expires_at timestamptz
  completed_at timestamptz

  indexes {
    (status, expires_at)
    (uploaded_by, status)
  }
}

Table idempotency_records {
  id uuid [pk]
  actor_id uuid [not null]
  operation_scope varchar(255) [not null]
  key varchar(128) [not null]
  request_hash varchar(64) [not null]
  result_type varchar(50) [not null]
  result_id uuid [not null, note: 'Polymorphic reference validated by service; not a database FK']
  result_application_version int
  result_document_version int
  http_status int [not null]
  created_at timestamptz [not null]
  expires_at timestamptz [not null]

  indexes {
    (actor_id, operation_scope, key) [unique]
    (expires_at)
  }
}

Ref: upload_intents.application_document_id > application_documents.id
Ref: upload_intents.uploaded_by > users.id
Ref: upload_intents.result_submission_id - document_submissions.id
Ref: idempotency_records.actor_id > users.id

// Migration constraints/triggers in CAMP_DATABASE_SCHEMA.md section 15 are mandatory:
// same-document current/review/intent pointers; choice membership/cardinality;
// status/pointer/acknowledgement checks; singleton, sizes, counts and revisions.
