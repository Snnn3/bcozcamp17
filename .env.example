# Server/CLI-only root environment. Never expose these values to browser bundles
# or commit a real .env file. Browser apps currently need no VITE_* secrets.
NODE_ENV=development
BCOZ_SEED_MODE=synthetic
PORT=3000
# Exact comma-separated origins only; no paths, credentials, wildcards, or queries.
WEB_ORIGINS=http://localhost:5173,http://localhost:5174
DATABASE_URL=postgresql://bcoz:bcoz_dev_password@localhost:55432/bcozcamp17?schema=public
SESSION_SECRET=replace-with-at-least-32-random-characters
# Local MinIO values; keep storage credentials server-side.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=bcoz-private
STORAGE_ACCESS_KEY_ID=bcoz_dev_access
STORAGE_SECRET_ACCESS_KEY=bcoz_dev_secret
STORAGE_FORCE_PATH_STYLE=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
